# Template only. Do NOT put your real key in this folder.
# Locally: save a copy with your real key at  %USERPROFILE%\.guidancebridge\.env
#          (e.g. C:\Users\<you>\.guidancebridge\.env), outside the project, so uploads can't include it.
# Online (Vercel/Render/Railway): add GROQ_API_KEY in the host's Environment Variables settings.
GROQ_API_KEY=your_key_here
# Optional
GROQ_MODEL=openai/gpt-oss-20b
PORT=3000
